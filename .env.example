# ── MELA environment variables ────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env or any file containing real secrets.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Application ───────────────────────────────────────────────────────────────
# Production URL — used for OAuth redirect allow-listing and SEO.
# Set to http://localhost:5173 for local development.
VITE_APP_URL=https://mela.pro.et

# ── Admin panel ───────────────────────────────────────────────────────────────
# Service-role key — NEVER share or commit. Only used in src/admin/.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
